# ============================================================
# SentinelaSOC - variaveis de ambiente
# Copie para .env e ajuste:  cp .env.example .env
# NUNCA faca commit do .env (ja esta no .gitignore)
# ============================================================

# ---------- Backend LLM: Ollama local (padrao deste projeto) ----------
# Qualquer modelo ja disponivel no `ollama list`
LLM_MODEL=qwen2.5:7b
OPENAI_BASE_URL=http://localhost:11434/v1
# Ollama nao exige chave, mas o cliente OpenAI exige valor nao vazio
OPENAI_API_KEY=ollama

# ---------- Backend alternativo: provedores OpenAI-compativeis ----------
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ---------- RAG / execucao (opcionais; defaults em src/sentinelasoc/settings.py) ----------
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RETRIEVAL_K=4
# LOG_LEVEL=INFO
